# Local development: leave DATABASE_URL unset to use SQLite (see PLAN.md §4.1).
# SQLITE_PATH defaults to ./local.db if unset.
# SQLITE_PATH=./local.db

# Production: set DATABASE_URL to the Supabase Postgres connection string
# (Supabase project settings > Database > Connection string > URI, pooler mode).
# DATABASE_URL=postgres://...

# Supabase (Phase 1 — Auth/Storage/Realtime)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=          # server-only, never expose to the client bundle

# Cloudinary (Phase 0/2 — image storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Upstash Redis (rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# HUTCH SMS API (Phase 1 — OTP)
# HUTCH_SMS_API_KEY=
# HUTCH_SMS_API_URL=

# PayHere (Phase 6 — payments)
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=

# Resend (transactional email)
# RESEND_API_KEY=
