# Local development: leave DATABASE_URL unset to use SQLite (see PLAN.md §4.1).
# SQLITE_PATH defaults to ./local.db if unset.
# SQLITE_PATH=./local.db

# Production: set DATABASE_URL to the Supabase Postgres connection string
# (Supabase project settings > Database > Connection string > URI, pooler mode).
# DATABASE_URL=postgres://...

# Supabase (Phase 1 — Auth/Storage/Realtime)
# Note: Supabase's newer projects issue "publishable" (sb_publishable_...) and
# "secret" (sb_secret_...) API keys instead of the legacy anon/service_role JWTs.
# They serve the same roles: publishable = safe for the client (with RLS enabled),
# secret = server-only, never expose to the client bundle.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Cloudinary (Phase 0/2 — image storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Upstash Redis (rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# HUTCH SMS — Bulk SMS gateway at bsms.hutch.lk (Phase 1 — OTP delivery)
# username/password authenticate against /api/login for a bearer token (cached
# in-process, re-authenticated only on expiry — see lib/otp/providers/hutch.ts).
# "mask" is the approved sender ID shown to recipients; "campaignName" is
# whatever Hutch assigned when the account was provisioned.
# HUTCH_SMS_USERNAME=
# HUTCH_SMS_PASSWORD=
# HUTCH_SMS_MASK=
# HUTCH_SMS_CAMPAIGN_NAME=

# Site URL — needed for absolute return/cancel/notify URLs (PayHere). Defaults
# to http://localhost:3000 in dev if unset; set to the real domain once linked.
# NEXT_PUBLIC_SITE_URL=

# PayHere (Phase 6 — payments)
# PAYHERE_MODE: "sandbox" (default if unset) or "live" — defaults to sandbox
# so a missing/misconfigured env var never accidentally hits real PayHere.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_MODE=sandbox

# Bank transfer (Phase 6 — the alternative payment method). Unset in dev on
# purpose — see lib/payments/bank-details.ts, which falls back to obvious
# placeholders rather than fabricated-but-real-looking numbers.
# BANK_TRANSFER_BANK_NAME=
# BANK_TRANSFER_ACCOUNT_NAME=
# BANK_TRANSFER_ACCOUNT_NUMBER=
# BANK_TRANSFER_BRANCH=

# Resend (transactional email)
# RESEND_API_KEY=
